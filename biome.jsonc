{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist/**/*",
      "!**/node_modules/**/*",
      "!**/coverage/**/*",
      "!**/CHANGELOG.md",
      "!**/.turbo/**/*",
      // Agent skill front matter must stay byte-exact; the formatter breaks it.
      "!**/SKILL.md",
      // Helm templates are Go templates, not YAML; helm lint checks them.
      "!deploy/helm/**/templates/**/*"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "bracketSpacing": false,
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off"
      },
      "performance": {
        // House rule: named imports only, never `import * as x`.
        "noNamespaceImport": "error"
      },
      "style": {
        "noUselessElse": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error"
      },
      "complexity": {
        "noForEach": "off",
        // House rule: all code lives in classes, including static-only helpers.
        "noStaticOnlyClass": "off"
      }
    }
  },
  // Layers: api -> service -> persistence, and every layer -> common. The
  // package dependencies enforce the direction between packages; this keeps
  // the API layer off the data layer. application.ts is the composition root.
  "overrides": [
    {
      "includes": ["apps/api/src/**", "!apps/api/src/application.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@express-boilerplate/persistence/**"],
                    "importNamePattern": ".*Entity",
                    "invertImportNamePattern": true,
                    "message": "The API layer calls the service layer. Only entity types may be imported from persistence (for converters)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
