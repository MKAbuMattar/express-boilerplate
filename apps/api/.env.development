# Loaded by `pnpm dev` only, before .env (which overrides it). No secrets here.
NODE_ENV=development
HEALTH_SHOW_DETAILS=always
# Local HTTPS name on 443. `pnpm certs` puts it in the server cert and prints
# the /etc/hosts line if it does not resolve. localhost keeps working.
PUBLIC_URL=https://api.express-boilerplate.len
