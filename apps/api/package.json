{
  "name": "@express-boilerplate/api",
  "description": "HTTP API: versioned REST resources, health and metrics endpoints, OpenAPI docs, and WebSocket, SSE and TCP on one TLS port.",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "node --watch --conditions=source --import tsx --disable-proto=delete --env-file=.env.development --env-file-if-exists=.env src/main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --disable-proto=delete --env-file-if-exists=.env dist/main.js",
    "certs": "tsx scripts/generate-certs.ts",
    "jwt": "tsx --conditions=source --env-file=.env.development --env-file-if-exists=.env scripts/issue-jwt.ts",
    "jwt:keygen": "tsx scripts/generate-jwt-key.ts",
    "routes": "tsx --conditions=source scripts/list-routes.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:containers": "vitest run --project containers",
    "test:e2e": "vitest run --project e2e",
    "test:monkey": "vitest run --project monkey",
    "test:security": "vitest run --project security",
    "test:chaos": "vitest run --project chaos",
    "test:dev": "vitest dev",
    "test:cov": "vitest run --coverage --project unit --project integration"
  },
  "dependencies": {
    "@express-boilerplate/common": "workspace:*",
    "@express-boilerplate/persistence": "workspace:*",
    "@express-boilerplate/service": "workspace:*",
    "@inversifyjs/http-core": "5.9.3",
    "@inversifyjs/http-express": "5.9.3",
    "@inversifyjs/http-open-api": "5.9.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "inversify": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@inversifyjs/open-api-types": "2.0.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "jose": "6.2.15",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.4",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
