{
  "name": "@express-boilerplate/api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --disable-proto=delete --env-file=.env.development --env-file-if-exists=.env src/main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --disable-proto=delete --env-file-if-exists=.env dist/main.js",
    "certs": "tsx scripts/generate-certs.ts",
    "jwt": "tsx --env-file=.env.development --env-file-if-exists=.env scripts/issue-jwt.ts",
    "jwt:keygen": "tsx scripts/generate-jwt-key.ts",
    "migration:show": "tsx --env-file=.env.development --env-file-if-exists=.env node_modules/typeorm/cli.js migration:show -d src/config/cli.data-source.ts",
    "migration:run": "tsx --env-file=.env.development --env-file-if-exists=.env node_modules/typeorm/cli.js migration:run -d src/config/cli.data-source.ts",
    "migration:revert": "tsx --env-file=.env.development --env-file-if-exists=.env node_modules/typeorm/cli.js migration:revert -d src/config/cli.data-source.ts",
    "migration:create": "tsx node_modules/typeorm/cli.js migration:create",
    "migration:prod": "node node_modules/typeorm/cli.js migration:run -d dist/config/cli.data-source.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:containers": "vitest run --project containers",
    "test:e2e": "vitest run --project e2e",
    "test:monkey": "vitest run --project monkey",
    "test:security": "vitest run --project security",
    "test:chaos": "vitest run --project chaos",
    "test:dev": "vitest dev",
    "test:cov": "vitest run --coverage --project unit --project integration"
  },
  "dependencies": {
    "@inversifyjs/http-core": "5.9.2",
    "@inversifyjs/http-express": "5.9.2",
    "@inversifyjs/http-open-api": "5.9.2",
    "@node-saml/node-saml": "5.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "bullmq": "6.7.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "envalid": "9.0.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "inversify": "8.2.4",
    "jose": "6.2.15",
    "mongodb": "7.8.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "sql.js": "1.15.2",
    "typeorm": "1.1.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@inversifyjs/open-api-types": "2.0.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.4",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
