# Copy to .env. Every value has a safe default except where marked REQUIRED.

# --- Server ---
NODE_ENV=development            # development | test | staging | production (Swagger /docs only in development)
HOST=0.0.0.0
PORT=443                        # Docker uses 8443 inside the container, published as 443
PUBLIC_URL=https://localhost    # external base URL, used for OIDC/SAML callback URLs
TRUST_PROXY=false               # true behind a load balancer that sets X-Forwarded-*
CORS_ORIGINS=                   # comma-separated, e.g. https://app.example.com,https://admin.example.com

# --- TLS (run `pnpm certs` for local certs) ---
TLS_ENABLED=true                # false when TLS terminates at a load balancer
TLS_KEY_FILE=certs/server.key
TLS_CERT_FILE=certs/server.crt
TLS_CA_FILE=certs/ca.crt        # CA that signs mTLS client certs

# --- Database ---
DB_TYPE=sqljs                   # postgres | mysql | mariadb | mongodb | mssql | sqljs
DB_URL=                         # e.g. postgres://app:app@localhost:5432/app
                                #      mysql://app:app@localhost:3306/app
                                #      mongodb://app:app@localhost:27017/app?authSource=admin
                                #      (sqljs: optional file path; empty = in-memory)
DB_MIGRATIONS_RUN=true          # apply pending migrations at startup (pnpm migration:run does it by hand)
DB_SYNCHRONIZE=false            # prototype only; schema changes go through src/migration

# --- Cache (Redis, Valkey, AWS ElastiCache) ---
CACHE_TYPE=memory               # memory | redis
CACHE_URL=                      # redis://localhost:6379, or rediss://... for TLS (ElastiCache in-transit encryption)
CACHE_CLUSTER=false             # true for cluster-mode endpoints
CACHE_TTL_SECONDS=60
CACHE_PREFIX=app:
CACHE_TIMEOUT_MS=200            # slower cache calls count as a miss

# --- A/B experiments: name:percentInA pairs ---
EXPERIMENTS=new-checkout:50

# --- Secrets: at least 32 characters. Generate: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=                 # REQUIRED in production
JWT_SECRET=                     # enables JWT auth
JWT_ISSUER=express-boilerplate
JWT_AUDIENCE=express-boilerplate

# --- HMAC clients: clientId:secret pairs ---
HMAC_CLIENTS=

# --- OAuth 2.0 resource server (external authorization server) ---
OAUTH2_ISSUER=                  # e.g. https://keycloak.example.com/realms/main
OAUTH2_AUDIENCE=
OAUTH2_JWKS_URI=                # e.g. https://keycloak.example.com/realms/main/protocol/openid-connect/certs

# --- OIDC login (SSO) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- SAML 2.0 login (SSO) ---
SAML_ENTRY_POINT=
SAML_ISSUER=                    # this service provider's entity ID
SAML_IDP_CERT=                  # IdP signing certificate (PEM)
