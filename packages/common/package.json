{
  "name": "@express-boilerplate/common",
  "description": "Shared infrastructure for every package: environment config, dependency injection, authentication guards, error responses, cache, queues, logging and observability.",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inversifyjs/http-core": "5.9.2",
    "@inversifyjs/http-express": "5.9.2",
    "@node-saml/node-saml": "5.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "bullmq": "6.7.0",
    "envalid": "9.0.0",
    "express": "5.3.0",
    "inversify": "8.2.4",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@inversifyjs/open-api-types": "2.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
