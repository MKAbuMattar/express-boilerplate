{
  "name": "@express-boilerplate/common",
  "description": "Shared infrastructure for every package: environment config, dependency injection, authentication guards, error responses, cache, queues, logging and observability.",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./*.js": {
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inversifyjs/http-core": "5.10.0",
    "@node-saml/node-saml": "5.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "bullmq": "6.7.2",
    "envalid": "9.0.0",
    "inversify": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@inversifyjs/http-express": "5.10.0",
    "@inversifyjs/open-api-types": "2.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
