{
  "uid": "api-overview",
  "title": "API overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (route) (rate(http_request_duration_seconds_count[1m]))", "legendFormat": "{{route}}"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency (seconds) by route",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Responses by status class",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (class) (label_replace(rate(http_request_duration_seconds_count[1m]), \"class\", \"${1}xx\", \"status\", \"(.).*\"))", "legendFormat": "{{class}}"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Event loop lag p99 (seconds)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "lag"}]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "App logs (audit lines first)",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{container=\"express-boilerplate\"}"}]
    }
  ]
}
