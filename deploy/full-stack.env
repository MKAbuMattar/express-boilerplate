# App settings for the full local stack:
#   APP_ENV_FILE=deploy/full-stack.env docker compose --profile full up --build
# Development values only. Secrets come from Vault (seeded by vault-seed).

NODE_EXTRA_CA_CERTS=/app/certs/ca.crt

# @feature:vault
# Vault: dev root token. Production: AppRole (VAULT_ROLE_ID/VAULT_SECRET_ID).
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
# @end:vault

# @feature:idp
# Keycloak (realm "demo") through APISIX on 443. The name resolves for the
# browser (/etc/hosts) and, through a network alias on APISIX, for the app, so
# both see the same issuer.
# @end:idp
# @feature:auth-oidc
OIDC_ISSUER=https://keycloak.express-boilerplate.len/realms/demo
OIDC_CLIENT_ID=express-boilerplate
OIDC_CLIENT_SECRET=dev-oidc-secret-change-me
# @end:auth-oidc
# @feature:auth-oauth2
OAUTH2_ISSUER=https://keycloak.express-boilerplate.len/realms/demo
OAUTH2_AUDIENCE=express-boilerplate-api
OAUTH2_JWKS_URI=https://keycloak.express-boilerplate.len/realms/demo/protocol/openid-connect/certs
# @end:auth-oauth2

# @feature:mail
SMTP_URL=smtp://mailpit:1025
# @end:mail
# @feature:tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# @end:tracing
