# Edge proxy: HTTP/3 (QUIC on UDP 443), HTTP/2 and HTTP/1.1 to clients;
# HTTPS with mTLS to the app. Caddy advertises HTTP/3 with Alt-Svc.
#
# Local: SITE_ADDRESS=localhost and the certs from `pnpm certs`.
# Production: set SITE_ADDRESS=api.example.com and delete the
# `tls /certs/server.crt ...` line's two file arguments to get automatic
# Let's Encrypt certificates (keep the client_auth block if you use mTLS).
{
	servers {
		protocols h1 h2 h3
	}
}

{$SITE_ADDRESS:localhost} {
	tls /certs/server.crt /certs/server.key {
		# Ask for a client certificate, but do not require one: only routes
		# behind MtlsGuard need it, and the app checks the forwarded copy.
		client_auth {
			mode request
			trust_pool file /certs/ca.crt
		}
	}

	reverse_proxy https://app:8443 {
		# Replaces any client-sent copy of the header.
		header_up X-Client-Cert {http.request.tls.client.certificate_der_base64}
		# Stream SSE and other long responses without buffering.
		flush_interval -1
		transport http {
			tls_trust_pool file /certs/ca.crt
			tls_server_name localhost
			# Proves to the app that this hop is the proxy, which is what
			# makes the app trust X-Client-Cert.
			tls_client_auth /certs/edge-proxy.crt /certs/edge-proxy.key
		}
	}
}
