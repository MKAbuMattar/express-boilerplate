{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "users:write",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ops:queues",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ops:network",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "api-audience",
      "description": "Puts the API in aud, so OAUTH2_AUDIENCE matches",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false"},
      "protocolMappers": [
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "express-boilerplate-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "express-boilerplate",
      "name": "Express Boilerplate (browser login, OIDC)",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-oidc-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://localhost/auth/oidc/callback", "https://localhost:8443/auth/oidc/callback"],
      "webOrigins": ["https://localhost"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["profile", "email"]
    },
    {
      "clientId": "api-client",
      "name": "Machine client (OAuth 2.0 client credentials)",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-api-secret-change-me",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["api-audience", "users:write"],
      "optionalClientScopes": ["ops:queues", "ops:network"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "alice", "temporary": false}]
    },
    {
      "username": "service-account-api-client",
      "enabled": true,
      "serviceAccountClientId": "api-client"
    }
  ]
}
