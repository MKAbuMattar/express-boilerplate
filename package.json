{
  "name": "express-boilerplate",
  "description": "Express and TypeScript API in a pnpm and Turborepo monorepo. HTTPS only on port 443, with separate packages for the API, business logic, data access and shared infrastructure.",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "homepage": "https://github.com/MKAbuMattar/express-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKAbuMattar/express-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/express-boilerplate/issues"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check ./apps ./packages",
    "lint:fix": "biome check --write ./apps ./packages",
    "fmt": "biome format --write ./apps ./packages",
    "certs": "pnpm --filter @express-boilerplate/api certs",
    "eb": "node packages/cli/src/main.ts",
    "jwt": "pnpm --filter @express-boilerplate/api jwt",
    "jwt:keygen": "pnpm --filter @express-boilerplate/api jwt:keygen",
    "migration:show": "pnpm --filter @express-boilerplate/persistence migration:show",
    "migration:run": "pnpm --filter @express-boilerplate/persistence migration:run",
    "migration:revert": "pnpm --filter @express-boilerplate/persistence migration:revert",
    "migration:create": "pnpm --filter @express-boilerplate/persistence migration:create",
    "migration:prod": "pnpm --filter @express-boilerplate/persistence migration:prod",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:containers": "turbo run test:containers",
    "test:e2e": "turbo run test:e2e",
    "test:monkey": "turbo run test:monkey",
    "test:security": "turbo run test:security",
    "test:chaos": "turbo run test:chaos",
    "test:cov": "turbo run test:cov"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
